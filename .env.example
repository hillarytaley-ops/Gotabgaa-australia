# Vercel environment variables

# Admin login
ADMIN_PASSWORD=your-secure-password
ADMIN_SECRET=generate-a-long-random-string

# Supabase Postgres (recommended — live CMS + contact inbox)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: GitHub backup when publishing (also updates data/content.json in repo)
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=hillarytaley-ops/Gotabgaa-australia

# Optional: transactional email via Resend (registration confirmations, approvals, payment receipts)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Gotabgaa Australia <noreply@yourdomain.com>
