# Vercel environment variables

# Admin login
ADMIN_PASSWORD=your-secure-password
ADMIN_SECRET=generate-a-long-random-string
# Optional: comma-separated emails that can open the leadership admin dashboard
# (hillarytaley@gmail.com is also bootstrapped in code)
ADMIN_EMAILS=hillarytaley@gmail.com

# Supabase Postgres + Auth (recommended — live CMS + member login)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public anon key (safe for browser) — Project Settings → API → anon public
SUPABASE_ANON_KEY=your-anon-public-key
# Used for password setup / reset email redirects
SITE_URL=https://gotabgaa-australia.vercel.app

# Optional: GitHub backup when publishing (also updates data/content.json in repo)
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=hillarytaley-ops/Gotabgaa-australia

# Optional: transactional email via Resend (registration confirmations, approvals, payment receipts)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Gotabgaa Australia <noreply@yourdomain.com>
